# Local compose stack configuration.
#
#   cp .env.example .env     (from infra/)
#
# docker compose reads infra/.env automatically. Real values stay on your
# machine: .env is git-ignored; this example carries placeholders only.

# --- Logto ---

# Password for the logto PostgreSQL role. REQUIRED — the stack refuses to
# start without it. Any throwaway dev value; never a production secret.
LOGTO_DB_PASSWORD=dev-only-placeholder-change-me

# Public base URL as reached from the host. Logto serves OIDC under
# <LOGTO_ENDPOINT>/oidc and reports that as the issuer.
LOGTO_ENDPOINT=http://localhost:3301
LOGTO_PORT=3301

# Admin console (local configuration of apps, API resources, users).
LOGTO_ADMIN_ENDPOINT=http://localhost:3302
LOGTO_ADMIN_PORT=3302

# --- Go API ---

API_PORT=8080
LOG_LEVEL=info

# Token identity wiring. ISSUER_URL must equal <LOGTO_ENDPOINT>/oidc exactly:
# the API checks every token's iss claim against it, and the Flutter app's
# CLUBINS_ISSUER dart-define defaults to the same value. Change
# LOGTO_ENDPOINT and ISSUER_URL together or validation fails closed.
ISSUER_URL=http://localhost:3301/oidc
AUDIENCE=https://api.clubins.de

# JWKS fetch location. Leave unset for the stack: inside the compose network
# the API pins the key fetch to the logto service (the compose file supplies
# the default). When the API runs on the host, omit JWKS_URL entirely and
# the issuer's discovery document is used.
# JWKS_URL=http://logto:3001/oidc/jwks

# --- Logto seeding (idp/) ---

# Credentials for the M2M application that drives the seed. The FIRST one is
# a one-time Admin Console bootstrap (idp/README.md): create a
# Machine-to-machine application and assign it the built-in "Logto Management
# API access" role. Copy its endpoint + ID + secret here.
LOGTO_M2M_CLIENT_ID=replace-me-m2m-client-id
LOGTO_M2M_CLIENT_SECRET=replace-me-m2m-client-secret

# Seed test user (idp/seed.sh creates it for local sign-in testing).
TEST_USER_EMAIL=dev@example.com
TEST_USER_PASSWORD=dev-only-placeholder-change-me

# Optional overrides — sensible defaults are compiled into idp/seed.sh and
# documented in idp/README.md. You likely need none of these. The one value
# you cannot choose in advance is the Flutter app's client ID: Logto
# generates it, the seed prints it, and you pass it at build time as
# --dart-define=CLUBINS_CLIENT_ID=<id>.
# LOGTO_MANAGEMENT_ENDPOINT=
# API_RESOURCE_INDICATOR=
# API_RESOURCE_NAME=
# LOGTO_APP_NAME=
# LOGTO_APP_TYPE=
# LOGTO_APP_REDIRECT_URI=
# LOGTO_APP_POST_LOGOUT_REDIRECT_URI=
# TEST_USER_ID=
# TEST_USER_NAME=
